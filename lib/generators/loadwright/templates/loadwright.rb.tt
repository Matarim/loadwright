# frozen_string_literal: true

# config/initializers/loadwright.rb
#
# Generated by `rails generate loadwright:install`.
#
# The `if defined?` guard below is REQUIRED. Rails evaluates every initializer
# in every environment, but this gem belongs in the :development, :test Gemfile
# group — without the guard, booting production raises NameError and the app
# does not start. Bullet solves it the same way. There is a spec asserting this
# guard is present in the generated file.
#
# Values referencing Faker, your own token issuer, etc. are illustrative and are
# commented out. They demonstrate the expected shape; they are not APIs this gem
# provides.

if defined?(Loadwright)
  Loadwright.configure do |config|
    # =========================================================================
    # EXECUTION MODE — see references/execution-modes.md
    #
    # :in_process finds query-structure problems fast with zero setup.
    # :http finds capacity problems with real server concurrency.
    # Neither is the "real" mode; most questions most of the time want the
    # default. What changes is which findings are measurable at all.
    # =========================================================================

    config.execution_mode = :in_process

    # :in_process cannot honestly measure concurrency, so it forces
    # concurrency_levels to [1] and marks concurrency-dependent findings
    # "unavailable" rather than reporting fabricated numbers. Enabling this
    # allows in-process threading with those caveats still applying.
    config.allow_in_process_threading = false

    # :http mode only. Loadwright boots a server unless a URL is given.
    config.http_server_command = nil # nil = auto (Puma)
    config.http_boot_timeout = 30    # seconds to wait for health

    # Targeting an already-running app instead of booting one. A non-loopback
    # target bypasses the local environment gate entirely — the thing receiving
    # load is a different process, possibly a different machine. Gated
    # separately from allow_production; see production-safety.md Layer 1b.
    config.http_target_url = nil
    config.allow_remote_http_target = false

    # =========================================================================
    # SAFETY — read this section first. Defaults here are intentionally
    # restrictive. Widening them is a deliberate decision, not a default.
    # =========================================================================

    # Only these environments may run Loadwright at all. Anything else aborts
    # before any config below is even evaluated.
    config.enabled_environments = [:development, :test]

    # Extra hostname/DATABASE_URL heuristics checked even inside an allowed
    # environment. See references/production-safety.md for the full flow.
    config.production_hostname_patterns = [
      /\.rds\.amazonaws\.com\z/,
      /^prod-/,
      /\.internal\z/,
    ]

    # Must be true, AND the confirmation phrase must be typed, AND
    # --i-understand-the-risk must be passed, for a run to proceed outside
    # enabled_environments. Leave false absent a reviewed reason.
    config.allow_production = false

    # What the user must type to confirm a production-adjacent run. Defaults to
    # your application's module name, so the phrase is specific to this app and
    # cannot be guessed generically.
    #
    # There is deliberately no generic fallback. If this cannot be resolved and
    # a run takes the production-adjacent path, Loadwright refuses and asks you
    # to set it explicitly — accepting a generic phrase would defeat the reason
    # the default is app-specific. On an ordinary dev/test run it is never
    # consulted.
    # config.confirmation_phrase = "MyApp"

    # GET/HEAD/OPTIONS only by default. Set true to allow discovered
    # POST/PUT/PATCH/DELETE endpoints to be exercised under load.
    config.allow_mutating_requests = false

    # Abort the remaining run if observed error rate crosses this fraction.
    #
    # Contention errors (lock waits, pool timeouts, statement timeouts) are
    # excluded from this figure — they belong to the resource guard, which
    # retreats per-endpoint rather than killing the run. This threshold is for
    # "this endpoint is broken": wrong auth, missing route, 500s.
    config.max_error_rate_before_abort = 0.20

    # Endpoints x scale factors x concurrency levels x requests per cell can
    # reach hours. Loadwright prints the estimated duration and worst-case
    # backoff budget before starting, and prompts for confirmation above this
    # many minutes.
    config.long_run_confirmation_threshold_minutes = 10

    # =========================================================================
    # SIDE-EFFECT CONTAINMENT — endpoints under load can do things well beyond
    # the database. All default to ON; turning any off means real emails, jobs
    # and webhooks may fire from a load test, including from your laptop.
    # =========================================================================

    # Forces ActionMailer delivery_method to :test for the run.
    config.suppress_mail_delivery = true

    # Forces ActiveJob queue_adapter to :test for the run, so jobs are recorded
    # (and counted in the report) rather than performed. Enqueue volume per
    # request is itself a useful signal — a request enqueuing 200 jobs is a
    # finding.
    config.suppress_background_jobs = true

    # Blocks outbound HTTP to anything not in outbound_http_allowlist.
    # Requires webmock; if unavailable, see abort_if_containment_unavailable.
    config.block_outbound_http = true
    config.outbound_http_allowlist = ["localhost", "127.0.0.1"]

    # If containment can't be enforced (missing dependency, custom mailer that
    # bypasses ActionMailer, a job backend invoked directly), abort rather than
    # proceed unprotected. Warning-and-continuing is the wrong default: you
    # believe you are contained, and silently not being contained is what sends
    # real email to real customers.
    config.abort_if_containment_unavailable = true

    # =========================================================================
    # RESPONSE ANALYSIS — the response is what proves the endpoint actually did
    # the work. See references/response-analysis.md.
    # =========================================================================

    # An endpoint whose response fails these checks is reported as
    # `inconclusive`, never as healthy. A 403 in 4ms with 1 query is not a fast
    # endpoint — it's an endpoint that did nothing.
    config.require_successful_response = true
    config.require_schema_valid_response = true

    # Warn when data was seeded but the endpoint returns an empty collection —
    # usually means factories don't match the endpoint's scope (tenant,
    # published flag, soft-delete, ownership).
    config.warn_on_empty_response_with_seeded_data = true

    # Query-count slope is measured against RETURNED record count, not seeded
    # count — a paginated endpoint hides its N+1 from seed-based slope
    # entirely. These params are swept to vary result size.
    config.page_size_parameters = ["per_page", "limit", "page[size]", "pageSize"]
    config.page_size_sweep = [5, 25, 100]

    # Over-fetch hints: tables/columns queried but absent from the response.
    # Reported as hints only — data is legitimately loaded for authorization
    # and filtering without being serialized.
    config.detect_overfetching = true

    # Unbounded-collection detection via payload growth.
    config.max_response_bytes_warning = 1_048_576 # 1 MB
    config.payload_growth_correlation_threshold = 0.8

    # Attribute N+1s to the serializer/template layer where possible —
    # serializer-level N+1s are the most commonly missed kind in API apps.
    config.serializer_attribution = true

    # =========================================================================
    # RESOURCE CONTENTION & BACKOFF — see references/resource-contention.md
    # Loadwright retreats from contention; it never kills sessions.
    # That doc's tuning table explains what each knob below trades away.
    # =========================================================================

    # :conservative (shared dev DB), :balanced (default, local DB you own),
    # :aggressive (throwaway/containerized DB). A preset fills in only the keys
    # you have not set yourself — anything you assign explicitly wins,
    # regardless of the order you assign it in.
    config.contention_profile = :balanced

    # Fail-fast timeouts applied to Loadwright's own connections so a blocked
    # query errors in seconds instead of hanging the run.
    config.lock_timeout_ms = 3_000
    config.statement_timeout_ms = 10_000

    # Baseline health check before the run. Aborts if the database is already
    # contended (migration running, long transaction, etc.).
    config.abort_on_unhealthy_baseline = true

    # Out-of-pool health sampling cadence.
    config.health_poll_interval_ms = 500

    # Tier 3 statistical degradation detection: p95 exceeding this multiple of
    # the endpoint's concurrency-1 baseline, for this many consecutive windows,
    # counts as contention.
    config.latency_degradation_multiplier = 4.0
    config.degradation_windows_before_backoff = 3

    # The backoff ladder (rungs 1-2).
    config.backoff_initial_delay_ms = 250
    config.backoff_multiplier = 2.0
    config.backoff_max_delay_ms = 15_000
    config.backoff_jitter = 0.3 # fraction; prevents synchronized retries
    config.max_backoff_attempts = 4

    # Ladder rungs 3-5: quarantine, cooldown, global abort.
    config.post_quarantine_cooldown_ms = 5_000
    config.max_consecutive_quarantines = 3
    config.max_health_check_retries = 3

    # =========================================================================
    # DISCOVERY — where Loadwright learns what endpoints exist
    # =========================================================================

<% if detected_openapi_paths.any? -%>
    # Detected on disk when this file was generated.
    config.openapi_spec_paths = [
<% detected_openapi_paths.each do |path| -%>
      Rails.root.join("<%= path %>"),
<% end -%>
    ]
<% else -%>
    # No OpenAPI/Swagger document was found when this file was generated, so this
    # is COMMENTED OUT deliberately. Naming a document that is not there is a hard
    # error, not a warning: Loadwright will not run a partial discovery, because an
    # endpoint that was never tested would be reported as absent rather than
    # skipped. That rule is right when YOU name the path -- but this generator
    # guessed it, and a guess must not fail your first run.
    #
    # Uncomment and correct it if you have one. The path shown is the
    # rswag/rspec-swagger convention. Until then, discovery uses integration-spec
    # recording plus route introspection, which needs no configuration.
    # config.openapi_spec_paths = [
    #   Rails.root.join("swagger/v1/swagger.yaml"),
    # ]
<% end -%>

    # Scanned in "recording" mode to capture real requests from your own specs.
    # See discovery-and-load-engine.md for why this records rather than
    # statically parses. Recording requires running your specs once:
    #   bundle exec loadwright record --specs spec/requests
<% if detected_integration_spec_paths.any? -%>
    # Detected on disk when this file was generated.
    config.integration_spec_paths = [
<% detected_integration_spec_paths.each do |path| -%>
      Rails.root.join("<%= path %>"),
<% end -%>
    ]
<% else -%>
    # No request-spec directory was found when this file was generated, so this is
    # commented out. Setting it makes Loadwright tell you to run `loadwright
    # record` against a directory that is not there, on every run.
    # config.integration_spec_paths = [
    #   Rails.root.join("spec/requests"),
    #   Rails.root.join("spec/integration"),
    # ]
<% end -%>

    # GRAPHQL. Every operation is a POST to one path, so there are no endpoints to
    # discover: the unit of work is the named operation. Setting graphql_path turns
    # this on; point it at your schema's route.
    #
    # Operations come from documents you already have, or from a list here.
    # Loadwright will not generate them from your schema by introspection: a
    # generated query exercises field combinations nobody asks for, and measures
    # traffic your app never receives.
    #
    # A GraphQL `query` counts as a READ even though it travels by POST, so
    # allow_mutating_requests is not needed to measure one. A `mutation` does count
    # as a write, and is held behind that gate like any other.
    # config.graphql_path = "/graphql"
    # config.graphql_document_paths = ["app/graphql/queries/*.graphql"]
    # config.graphql_operations = [
    #   { name: "PostsWithComments",
    #     query: "query PostsWithComments($first: Int!) { posts(first: $first) { id } }",
    #     variables: { "first" => 25 } }
    # ]

    # PAGINATION. The page-size sweep is what catches an N+1 hiding behind
    # pagination, and in GraphQL the page size lives in a VARIABLE rather than a
    # query parameter. An operation that hardcodes `first: 10` cannot be varied and
    # is reported as unsweepable; parameterise it as `$first` and it can be.
    # These are the variable names treated as a page size.
    # config.graphql_page_size_variables = %w[first last pageSize limit]

    # Fall back to Rails route introspection for anything neither source
    # covers (lower fidelity — no example params).
    config.route_discovery = true

    config.excluded_paths = [
      %r{^/rails/},
      %r{^/admin/},
      %r{^/health},
    ]

    # If set, ONLY these paths are considered. nil = no extra restriction.
    config.included_paths = nil

    # Real IDs for path params like /posts/{id}. Resolved from seeded records
    # first; this is the override for anything that can't be inferred (slugs,
    # UUIDs, composite keys). Without resolution most nested endpoints 404 and
    # the run reports nothing useful.
    config.path_param_overrides = {
      # "/api/v1/posts/{slug}" => { slug: -> { Post.first&.slug } },
    }

    # =========================================================================
    # AUTH
    # =========================================================================

    # How the token below is attached to each request:
    #   :bearer_token  Authorization: Bearer <token>   (JWT, Doorkeeper, most APIs)
    #   :session       Cookie: <token>                 (Devise and friends)
    #   :header        X-Api-Key: <token>              (API-key APIs)
    # For a fully public API, leave auth_token_provider nil below and no auth
    # header is sent; this setting is then unused.
    config.auth_strategy = :bearer_token

    # Replace with your app's own token logic. May return a single token or a
    # collection; a collection rotates identities across requests, which
    # matters for multi-tenant apps where single-identity traffic can make a
    # badly-scoped query look fine.
    config.auth_token_provider = -> { ENV.fetch("LOADWRIGHT_TOKEN", nil) }

    # ...or log in the way your own clients do, and let Loadwright keep the token.
    # Issued once per credential before the run, through the same transport; these
    # requests are setup and are never measured or reported as endpoints. Set this
    # OR auth_token_provider above, not both.
    # config.auth_login = {
    #   path: "/api/v1/login",
    #   verb: :post,
    #   credentials: [{ email: "dev@example.com", password: "password" }],
    #   extract: { json: "token" }   # or { header: "Set-Cookie" } for session auth
    # }

    # Seed and rotate across this many identities when the provider doesn't
    # supply its own collection.
    config.test_identity_pool_size = 5

    config.default_headers = { "Accept" => "application/json" }

    # =========================================================================
    # DATA SEEDING — FactoryBot-driven population at scale
    # =========================================================================

    config.factory_bot_enabled = true

    # Resource name => factory (+ optional trait). Anything unlisted is skipped
    # for seeding; its endpoints can still be hit.
    config.factory_map = {
      # "user" => { factory: :user },
      # "post" => { factory: :post, trait: :with_comments },
    }

    # Population sizes tested, in order. Query-count-vs-scale-factor is the
    # core N+1 heuristic — see discovery-and-load-engine.md.
    config.scale_factors = [1, 10, 50, 200]

    # Seed in batches with a health check between them, so a large scale factor
    # can't lock the table in one giant transaction.
    config.seed_batch_size = 50

    # :delete_created_rows (default) — tracks IDs Loadwright inserted and
    #   removes only those. NEVER truncates whole tables.
    # :transactional_rollback — wraps the run in a transaction; fastest, but
    #   connection-pool behavior won't match a real multi-connection scenario,
    #   so pool findings are less trustworthy. Unavailable in :http mode.
    # :leave — do nothing; useful for inspecting seeded state afterward.
    config.seed_cleanup_strategy = :delete_created_rows

    # Also clean up rows your APP created while answering requests -- a POST that
    # writes three tables, or a GET that logs an audit row. Same id-bounded
    # watermark mechanism as above; never a TRUNCATE.
    # On a database you share with other people, setting this to false narrows the
    # sweep to tables only your factories wrote to. It does not remove it: those
    # tables are swept above a watermark either way. `:leave` above is the setting
    # that cleans up nothing at all.
    config.cleanup_request_created_rows = true

    # Escape hatch for resources with no factory at all. Not the primary
    # uniqueness mechanism — that's your factories' own sequences.
    config.unique_field_generator = nil

    # =========================================================================
    # LOAD SHAPE
    # =========================================================================

    config.concurrency_levels = [1, 5, 20]
    config.requests_per_endpoint_per_level = 25
    config.request_timeout = 5 # seconds
    config.warmup_requests = 3 # measured as cold-cache, not discarded

    # =========================================================================
    # INSTRUMENTATION
    # =========================================================================

    config.detect_n_plus_one = true
    config.track_memory_allocations = true
    config.track_connection_pool = true

    # ActiveRecord's query cache dedupes identical queries within a request,
    # which can hide a textbook N+1 completely. Disabled during runs so query
    # counts reflect code structure. When left enabled, N+1 findings are
    # labelled as potentially undercounted.
    config.disable_query_cache_during_run = true

    # Where the time actually went: db / view / GC / external / other.
    # An endpoint that is 80% serialization is not a database problem.
    config.track_time_breakdown = true
    config.track_gc_stats = true

    # EXPLAIN runs after the load phase, never during it. ANALYZE is used only
    # on SELECTs — EXPLAIN ANALYZE executes the statement, so running it on a
    # write would perform the write.
    config.run_explain_on_slow_queries = true
    config.explain_top_n_queries = 5
    config.seq_scan_row_threshold = 10_000

    # Cold-cache performance is what users hit right after a deploy. Measured
    # and reported alongside warm rather than discarded.
    config.measure_cold_cache = true

    # Postgres only; requires pg_stat_statements. Ignored elsewhere.
    config.track_pg_stat_statements = true

    config.slow_query_threshold_ms = 100

    # Percentiles the sample size can't support are omitted, not caveated.
    # Raising requests_per_endpoint_per_level is the documented fix.
    config.min_samples_for_percentiles = { p50: 20, p95: 100, p99: 500 }

    # Flag Puma threads x workers exceeding the AR pool size even when no
    # contention was observed — it's a latent problem worth stating.
    config.check_pool_vs_server_threads = true

    # Jobs enqueued PER REQUEST above which the volume is itself a finding.
    # Not zero — enqueuing a job from a POST is ordinary. A request fanning
    # out into 200 jobs is not, and containment is what makes it visible:
    # the :test adapter records them instead of performing them.
    config.jobs_enqueued_warning_threshold = 10

    # =========================================================================
    # RUN HISTORY & COMPARISON — see references/run-comparison.md
    # =========================================================================

    config.run_history_dir = Rails.root.join("tmp/loadwright/runs")
    config.run_history_limit = 50

    # Latency on a laptop routinely moves 10-20% between identical runs.
    # Query-count deltas are near-deterministic and are the primary regression
    # signal; latency deltas must clear this threshold AND the measured noise
    # floor before being called a regression.
    config.regression_threshold_pct = 20
    config.fail_on_regression = false

    # =========================================================================
    # REDACTION — reports contain request/response bodies and SQL from a real
    # database. Sanitizing happens at collection time, not render time, so
    # secrets never reach the persisted run record either.
    # =========================================================================

    # Rails already knows what's sensitive; honor its declaration.
    config.honor_rails_filter_parameters = true
    # LEFT COMMENTED OUT ON PURPOSE. Assigning this key REPLACES the shipped defaults,
    # so an initializer carrying yesterday's list keeps yesterday's list -- and a later
    # release that widens the defaults to catch a credential header yours uses never
    # reaches you. Recordings are written to disk in plaintext; a missed credential is
    # the one redaction failure that matters.
    #
    # Shipped defaults: authorization, cookie, api-key, auth, token, secret,
    # credential, session, signature, x-*-key.
    #
    # To ADD without losing them, append rather than assign:
    #   config.redact_additional_patterns = [/\Ax-my-app-ticket\z/i]
    # config.redact_header_patterns = [/authorization/i, /cookie/i, /api[-_]?key/i]
    config.redact_sql_bind_values = true
    config.include_response_bodies = false
    config.redact_additional_patterns = []

    # =========================================================================
    # THRESHOLDS — optional pass/fail for scripted use
    # =========================================================================

    config.fail_on_n_plus_one = false
    config.p95_latency_budget_ms = { default: 500 }

    # =========================================================================
    # REPORTING
    # =========================================================================

    config.report_formats = [:html, :markdown]
    config.report_output_dir = Rails.root.join("tmp/loadwright")
    config.report_filename_pattern = "%Y%m%d-%H%M%S-report"

    # Always write a report even when the run aborts partway. An aborted run
    # producing no output is a bug — the abort is often the most interesting
    # finding.
    config.write_partial_report_on_abort = true

    # =========================================================================
    # NOTIFICATIONS (optional)
    # =========================================================================

    config.slack_webhook_url = nil
  end
end
